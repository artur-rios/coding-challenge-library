# Local environment. Copy to docker/local.env and fill in the two passwords; that copy is
# gitignored, and no real credential ever belongs in this file.
#
#     cp docker/local.env.example docker/local.env
#     docker compose --env-file docker/local.env up -d --build

COMPOSE_PROJECT_NAME=library-local

# Development serves Swagger UI, turns on EF's command logging, and lets EF include parameter values
# in its diagnostics. Production turns all three off - parameter logging in particular would put
# reader names and e-mail addresses in the log on every query.
ASPNETCORE_ENVIRONMENT=Development

# Published on every interface so the API answers at http://localhost:8080 - and from a phone or a VM
# on the same network, which "127.0.0.1:8080" would prevent.
API_PORT=8080

# The database this deployment owns. Postgres and Redis are published to the loopback interface only
# (see docker-compose.yml), so these ports are for a local client and not for the network.
#
# They are host-side ports: if you already run PostgreSQL or Redis on this machine, change them
# (55432 and 56379 work) rather than stopping the local service. The API reaches both over the
# Compose network on their standard ports regardless, so nothing else has to change.
DB_NAME=library
DB_PORT=5432
DB_USER=library
DB_PASSWORD=

REDIS_PORT=6379

# How long a used Idempotency-Key is honoured. After this, a repeat of the same key does the work
# again - which is the right answer, because a client retrying a day later is making a new request
# rather than finishing an old one.
LIBRARY_IDEMPOTENCY_RETENTION_HOURS=24

# OTLP collector endpoint for traces and metrics, e.g. http://otel-collector:4317. Leave empty and
# the instrumentation still runs but exports nowhere.
LIBRARY_OTLP_ENDPOINT=
